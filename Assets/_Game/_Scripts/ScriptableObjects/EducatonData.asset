  m_Script: {fileID: 11500000, guid: 645b4adfe27e58643a07548c58212cb6, type: 3}
  m_Name: EducatonData
  m_EditorClassIdentifier: 
  data:
  - text: "\u0428\u0435\u0432\u0435\u043B\u0438 \u043B\u0430\u043F\u043A\u0430\u043C\u0438!
      \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 - WASD"
    timeBefore: 0
    sprite: {fileID: 702775933, guid: 19e920bd7c703aa49b5ff36c2927957e, type: 3}
    theme: 0
  - text: "\u0421\u0442\u0440\u0435\u043B\u044C\u0431\u0430 - \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F.
      \u0413\u043B\u0430\u0432\u043D\u043E\u0435 - \u0443\u0441\u043F\u0435\u0432\u0430\u0442\u044C
      \u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    timeBefore: 0
    sprite: {fileID: 1979409143, guid: 19e920bd7c703aa49b5ff36c2927957e, type: 3}
    theme: 1
  - text: "\u0417\u043E\u043C\u0431\u0438 \u0447\u0430\u0441\u0442\u043E \u0445\u043E\u0434\u044F\u0442
      \u0433\u0440\u0443\u043F\u043F\u0430\u043C\u0438, \u0431\u0443\u0434\u044C
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435.\n"
    timeBefore: 0
    sprite: {fileID: -886292131, guid: d9cdefa1d0ffc0344b1c3e4329431f0d, type: 3}
    theme: 2
  - text: "\u042D\u0442\u043E \u0442\u0432\u043E\u044F \u0431\u0430\u0437\u0430.
      \u0422\u0438\u0445\u043E, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u043D\u043E \u043F\u0443\u0441\u0442\u043E\u0432\u0430\u0442\u043E. \u041D\u0430\u0434\u043E
      \u043E\u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u0438\u0442\u044C."
    timeBefore: 0
    sprite: {fileID: 21300000, guid: dd2cbcba7205ac3469573d6264b75fe8, type: 3}
    theme: 4
  - text: "\u0421\u0442\u0440\u043E\u0438\u0442\u044C \u043C\u043E\u0436\u043D\u043E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0445\u043E\u0440\u043E\u0448\u0435\u043C
      \u0433\u0440\u0443\u043D\u0442\u0435 - \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D
      \u0441\u0438\u043D\u0438\u043C."
    timeBefore: 5
    sprite: {fileID: 21300000, guid: a3d15b9ebf980b54faf4dfe6517d750f, type: 3}
    theme: 5
  - text: "\u041F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043C \u043A \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0435.
      \u041D\u0430\u0436\u043C\u0438 \u043A\u043D\u043E\u043F\u043A\u0443 \u0434\u043B\u044F
      \u0432\u044B\u0437\u043E\u0432\u0430 \u043C\u0435\u043D\u044E"
    timeBefore: 3
    sprite: {fileID: 21300000, guid: 1db638f5a81d8cf4da6f05e6b53424d1, type: 3}
    theme: 6
  - text: "\u041A\u043E\u0442\u044D \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043E\u0442\u044F\u0442
      \u043A\u0443\u0448\u0430\u0446. \u041F\u043E\u0441\u0442\u0440\u043E\u0439
      \u0430\u043A\u0432\u0430\u0440\u0438\u0443\u043C \u0434\u043B\u044F \u0440\u044B\u0431\u043E\u0432"
    timeBefore: 0
    sprite: {fileID: 21300000, guid: 49a9e5d9dffb0454b8ca3f21d754845c, type: 3}
    theme: 7
  - text: "\u0421\u0432\u0435\u0436\u0430\u044F \u0432\u043E\u0434\u0430 - \u0437\u0430\u043B\u043E\u0433
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F. \u041F\u043E\u0441\u0442\u0440\u043E\u0439
      \u0431\u043E\u0447\u043A\u0443 \u0441 \u0432\u043E\u0434\u043E\u0439"
    timeBefore: 0
    sprite: {fileID: 21300000, guid: 73722c93e1ed00e49b77d1ba3474780c, type: 3}
    theme: 8
  - text: "\u0423 \u043A\u043E\u0442\u043E\u0432 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435 \u043B\u0430\u043F\u043A\u0438.
      \u041F\u043E\u0441\u0442\u0440\u043E\u0439 \u0432\u0435\u0440\u0441\u0442\u0430\u043A,
      \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u043B\u043E, \u0433\u0434\u0435
      \u0438\u0445 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
    timeBefore: 0
    sprite: {fileID: 21300000, guid: 27110a33eb3f9244fbd15ecb464f82bf, type: 3}
    theme: 9
  - text: "1. \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
      \u0434\u0430\u044E\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B - \u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430\u0432\u0435\u0440\u0445\u0443 \u044D\u043A\u0440\u0430\u043D\u0430.
      \r\n2. \u0414\u043B\u044F \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u043D\u0443\u0436\u043D\u044B \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B.
      \u0418\u0445 \u043B\u0443\u0447\u0448\u0435 \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u043B\u0430\u0437\u043E\u043A
      \r\n3. \u0415\u0434\u0430 \u0438 \u0432\u043E\u0434\u0430 - \u043D\u0443\u0436\u043D\u044B
      \u0438 \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0442\u044C \u0432\u044B\u043B\u0430\u0437\u043A\u0438
      \u0437\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438
      \u0432 \u0433\u043E\u0440\u043E\u0434"
    timeBefore: 0
    sprite: {fileID: 21300000, guid: 5e8b38107b514dd44bca03b623273bc5, type: 3}
    theme: 10
  - text: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0441\u0432\u043E\u0438\u043C
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C. \u0421\u043E\u0436\u0440\u0443\u0442
      - \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0448\u044C.\n"
    timeBefore: 0
    sprite: {fileID: 0}
    theme: 11
  - text: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u043E\u043C\u0431\u0438
      \u0442\u043E\u043B\u0449\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445.
      \u041D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0443\u043B\u044C. "
    timeBefore: 0
    sprite: {fileID: 0}
    theme: 11
  - text: "\u0422\u044B \u0447\u0443\u0435\u0448\u044C \u0438\u0445. \u042D\u0442\u043E
      \u0435\u0449\u0451 \u043D\u0435 \u043A\u043E\u043D\u0435\u0446. \u041D\u0443\u0436\u043D\u043E
      \u043E\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043E."
    timeBefore: 0
    sprite: {fileID: 0}
    theme: 11
